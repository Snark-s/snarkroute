{
  "routeVersion": "0.1",
  "route": {
    "id": "example-plugin-env-echo",
    "title": "Example Plugin Env Echo",
    "author": {
      "name": "SnarkRoute maintainers"
    }
  },
  "economics": {
    "enabled": false,
    "mode": "disabled"
  },
  "nodes": [
    {
      "id": "input",
      "type": "input.text",
