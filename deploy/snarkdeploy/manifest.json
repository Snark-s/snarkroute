{
  "schema_version": 2,
  "name": "Snark workstation",
  "variables": {
    "SNARK_PROCESS_ROOT": {
      "default": "Y:/Процесс"
    },
    "SNARK_APPS_ROOT": {
      "default": "Y:/Приложения"
    },
    "SNARKROUTE_ROOT": {
      "default": "{{SNARK_PROCESS_ROOT}}\\SnarkRoute"
    },
    "SNARK_MIXAR_SOURCE": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Mixar Source"
    },
    "SNARK_MIXAR_BACKEND": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Mixar Local"
    },
    "SNARK_JABBER_BLENDER": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Blender"
    },
    "SNARK_MIXAR_INSTALL": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Mixar Runtime"
    },
    "SNARK_MIXAR_PROFILE": {
      "default": "{{APPDATA}}\\Mixar\\Mixar\\5.2"
    },
    "SNARK_REGISTRY_PATH": {
      "default": "{{LOCALAPPDATA}}\\SnarkRoute\\service-registry.json"
    },
    "SNARK_AI_ROOT": {
      "default": "I:\\AI"
    },
    "PERSONA_HOME": {
      "default": "I:\\PersonaCore"
    },
    "SNARK_ARCENGINE": {
      "default": "{{SNARK_AI_ROOT}}\\ArcEngine"
    },
    "SNARK_HOLLYWOOD": {
      "default": "{{SNARK_APPS_ROOT}}\\Hollywood_2.0"
    },
    "SNARK_FREETOKEN": {
      "default": "{{SNARK_AI_ROOT}}\\FreeToken Desktop"
    },
    "SNARK_BONSAI": {
      "default": "{{SNARK_AI_ROOT}}\\Bonsai-demo"
    },
    "SNARK_AE_PANEL": {
      "default": "{{APPDATA}}\\Adobe\\CEP\\extensions\\com.snarkroute.aftereffects"
    },
    "SNARKBRIDGE_ROOT": {
      "default": "{{PERSONA_HOME}}\\..\\SnarkBridge"
    }
  },
  "prerequisites": [
    {
      "id": "git",
      "command": "git",
      "required": true,
      "winget_id": "Git.Git"
    },
    {
      "id": "node",
      "command": "node",
      "required": true,
      "winget_id": "OpenJS.NodeJS.LTS"
    },
    {
      "id": "corepack",
      "command": "corepack",
      "required": true
    },
    {
      "id": "python",
      "command": "python",
      "alternatives": [
        "py"
      ],
      "required": true,
      "winget_id": "Python.Python.3.11"
    },
    {
      "id": "uv",
      "command": "uv",
      "required": false,
      "winget_id": "astral-sh.uv"
    },
    {
      "id": "ffmpeg",
      "command": "ffmpeg",
      "required": false,
      "winget_id": "Gyan.FFmpeg"
    },
    {
      "id": "wsl",
      "command": "wsl.exe",
      "required": false
    },
    {
      "id": "nvidia",
      "command": "nvidia-smi",
      "required": false
    },
    {
      "id": "ollama",
      "command": "ollama",
      "required": false,
      "winget_id": "Ollama.Ollama"
    }
  ],
  "components": [
    {
      "id": "snarkroute",
      "label": "SnarkRoute",
      "path": "{{SNARKROUTE_ROOT}}",
      "strategy": "git",
      "remote": "https://github.com/Snark-s/snarkroute.git",
      "snapshot": true,
      "install_commands": [
        "corepack enable",
        "corepack pnpm install --frozen-lockfile"
      ],
      "patch_excludes": [
        "apps/server/data/h3-studio/queue.json",
        "apps/server/data/h3-studio/results/**",
        "apps/server/nohup.out"
      ]
    },
    {
      "id": "after-effects-panel",
      "label": "SnarkRoute After Effects CEP panel",
      "path": "{{SNARK_AE_PANEL}}",
      "strategy": "copy",
      "snapshot": true,
      "install_commands": [
        "powershell -NoProfile -Command \"New-Item -Path 'HKCU:\\Software\\Adobe\\CSXS.11' -Force | Out-Null; New-ItemProperty -Path 'HKCU:\\Software\\Adobe\\CSXS.11' -Name PlayerDebugMode -Value '1' -PropertyType String -Force | Out-Null\"",
        "powershell -NoProfile -Command \"New-Item -Path 'HKCU:\\Software\\Adobe\\CSXS.12' -Force | Out-Null; New-ItemProperty -Path 'HKCU:\\Software\\Adobe\\CSXS.12' -Name PlayerDebugMode -Value '1' -PropertyType String -Force | Out-Null\""
      ]
    },
    {
      "id": "mixar-program",
      "label": "Mixar application",
      "path": "{{SNARK_MIXAR_INSTALL}}",
      "strategy": "copy",
      "snapshot": true,
      "requires_admin_restore": false
    },
    {
      "id": "mixar-profile",
      "label": "Mixar user profile and startup scripts",
      "path": "{{SNARK_MIXAR_PROFILE}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "mixar-source",
      "label": "Modified Mixar source",
      "path": "{{SNARK_MIXAR_SOURCE}}",
      "strategy": "git-or-copy",
      "snapshot": true
    },
    {
      "id": "mixar-local-backend",
      "label": "Jabberwock Mixar Local backend",
      "path": "{{SNARK_MIXAR_BACKEND}}",
      "strategy": "git-or-copy",
      "snapshot": true,
      "snapshot_ignored_paths": [
        "config.json",
        "generation_jobs_state.json",
        "generation_performance.json",
        "model_performance.json",
        "snarkroute_generation_catalog_cache.json",
        "generation_inputs",
        "turn_journal",
        "trellis-recovery-test",
        "mixar-app-main.zip"
      ]
    },
    {
      "id": "jabberwock-blender",
      "label": "Jabberwock Blender client",
      "path": "{{SNARK_JABBER_BLENDER}}",
      "strategy": "git-or-copy",
      "snapshot": true
    },
    {
      "id": "personacore",
      "label": "PersonaCore",
      "path": "{{PERSONA_HOME}}",
      "strategy": "git-or-copy",
      "snapshot": true,
      "install_commands": [
        "python -m venv .venv",
        ".venv\\Scripts\\python.exe -m pip install -r requirements.txt",
        "npm ci --prefix extension",
        "npm run build --prefix extension"
      ],
      "snapshot_excludes": [
        "config/secrets.*",
        "data/runtime/agent/tasks/**",
        "data/runtime/harness/**"
      ],
      "snapshot_ignored_paths": [
        "data",
        "config/local.cloud.json"
      ]
    },
    {
      "id": "arcengine",
      "label": "ArcEngine previs",
      "path": "{{SNARK_ARCENGINE}}",
      "strategy": "git",
      "remote": "https://github.com/xaidan777/ArcEngine.git",
      "snapshot": true
    },
    {
      "id": "hollywood2",
      "label": "Hollywood 2",
      "path": "{{SNARK_HOLLYWOOD}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "freetoken",
      "label": "FreeToken Desktop",
      "path": "{{SNARK_FREETOKEN}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "bonsai",
      "label": "Bonsai 2 local runtime",
      "path": "{{SNARK_BONSAI}}",
      "strategy": "git",
      "remote": "https://github.com/PrismML-Eng/Bonsai-demo.git",
      "snapshot": true
    },
    {
      "id": "snarkbridge",
      "label": "SnarkBridge private ChatGPT MCP and tunnel",
      "path": "{{SNARKBRIDGE_ROOT}}",
      "strategy": "copy",
      "snapshot": true,
      "snapshot_excludes": [
        ".tunnel-key.dpapi",
        ".venv",
        ".venv/**",
        "__pycache__",
        "__pycache__/**",
        "*.pyc",
        "workspace",
        "workspace/**",
        "dist",
        "dist/**",
        "*.zip",
        "*.zip.sha256",
        "SNARKBRIDGE_ENV.ps1",
        "logs/**",
        "*.log",
        "*.pid",
        "*.tmp",
        "secrets/**"
      ],
      "install_commands": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\RESTORE_SNARKBRIDGE.ps1"
      ]
    }
  ],
  "services": [
    {
      "id": "snarkroute",
      "label": "SnarkRoute API",
      "component": "snarkroute",
      "start": "{{SNARKROUTE_ROOT}}\\start-server.bat",
      "stop": "{{SNARKROUTE_ROOT}}\\stop-snarkroute.bat",
      "registry_service": "snarkroute"
    },
    {
      "id": "mixar-bridge",
      "label": "Mixar/Jabberwock bridge",
      "component": "mixar-profile",
      "registry_service": "mixar_bridge"
    },
    {
      "id": "mixar-local-backend",
      "label": "Mixar local backend",
      "component": "mixar-local-backend",
      "registry_service": "mixar_sidecar"
    },
    {
      "id": "h3-local",
      "label": "MiniMax H3 local worker",
      "component": "snarkroute",
      "resource_class": "gpu-heavy",
      "registry_service": "h3_worker"
    },
    {
      "id": "local-upscale",
      "label": "Local upscale worker",
      "component": "snarkroute",
      "resource_class": "gpu",
      "registry_service": "local_upscale"
    },
    {
      "id": "bonsai-local",
      "label": "Bonsai 2 27B local OpenAI API",
      "component": "bonsai",
      "resource_class": "gpu-heavy",
      "registry_service": "bonsai_inference"
    },
    {
      "id": "ollama",
      "label": "Ollama local runtime",
      "resource_class": "gpu",
      "registry_service": "ollama_inference"
    },
    {
      "id": "freetoken-api",
      "label": "FreeToken OpenAI-compatible API",
      "component": "freetoken",
      "registry_service": "freetoken"
    }
  ],
  "inventories": [
    "{{SNARKROUTE_ROOT}}\\workers\\minimax-h3\\model-manifest.yaml",
    "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\model-registry.json",
    "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\video-model-registry.json",
    "{{SNARK_REGISTRY_PATH}}",
    "{{PERSONA_HOME}}\\projects\\registry.json",
    "{{PERSONA_HOME}}\\data\\runtime\\host-mappings.json"
  ],
  "snapshot_excludes": [
    ".git",
    "node_modules",
    ".pnpm-store",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".cache",
    "models",
    "artifacts",
    "reports",
    ".env",
    ".env.local",
    ".env.production",
    "credentials.json",
    "secrets.json",
    ".ruff_cache",
    "graphify-out",
    "test-results",
    "logs",
    "*.tmp",
    "*.part",
    ".tmp",
    ".codex",
    "service-endpoints.paths.json"
  ],
  "global_npm_packages": [
    "@deepseek-ai/dsh@0.1.1-rc.2",
    "pm2@7.0.3"
  ],
  "heavy_inventories": [
    {
      "id": "bonsai-models",
      "path": "{{SNARK_BONSAI}}\\models",
      "hash": true,
      "include": [
        "*.gguf"
      ]
    },
    {
      "id": "local-upscale-models",
      "path": "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\models",
      "hash": true,
      "include": [
        "*"
      ]
    },
    {
      "id": "ai-models",
      "path": "{{SNARK_AI_ROOT}}\\models",
      "hash": false,
      "include": [
        "*"
      ]
    }
  ],
  "wsl_inventories": [
    {
      "id": "h3-models",
      "distro": "Ubuntu-24.04",
      "command": "timeout 20s find ~/h3/models -type f -printf '%p\\t%s\\n' 2>/dev/null | sort"
    },
    {
      "id": "h3-runtime",
      "distro": "Ubuntu-24.04",
      "command": "timeout 20s find ~/h3/runtime -maxdepth 3 -type f -printf '%p\\t%s\\n' 2>/dev/null | sort"
    }
  ],
  "secret_requirements": [
    {
      "id": "mixar-rpc-owner-token",
      "path": "{{LOCALAPPDATA}}\\SnarkDream\\mixar_bridge_rpc.dpapi",
      "restore": "owner-authorized-regenerate-with-scripts/provision-mixar-rpc-token.ps1"
    },
    {
      "id": "snarkroute-env",
      "path": "{{SNARKROUTE_ROOT}}\\.env",
      "restore": "manual-or-vault"
    },
    {
      "id": "local-upscale-env",
      "path": "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\.env",
      "restore": "manual-or-vault"
    },
    {
      "id": "h3-worker-token",
      "path": "WSL:~/h3/runtime/worker-token",
      "restore": "regenerate"
    },
    {
      "id": "personacore-cloud-token",
      "path": "{{PERSONA_HOME}}\\config\\secrets.cloud-token",
      "restore": "regenerate"
    },
    {
      "id": "personacore-extension-token",
      "path": "{{PERSONA_HOME}}\\config\\secrets.extension-token",
      "restore": "regenerate"
    },
    {
      "id": "personacore-harness-credentials",
      "path": "{{PERSONA_HOME}}\\data\\runtime\\harness\\.credentials.yaml",
      "restore": "manual-or-regenerate"
    }
  ]
}
