{
  "schema_version": 2,
  "name": "Snark workstation",
  "variables": {
    "SNARK_PROCESS_ROOT": {
      "default": "Y:\\Процесс"
    },
    "SNARK_APPS_ROOT": {
      "default": "Y:\\Приложения"
    },
    "SNARKROUTE_ROOT": {
      "default": "{{SNARK_PROCESS_ROOT}}\\SnarkRoute"
    },
    "SNARK_MIXAR_SOURCE": {
      "default": "{{SNARK_PROCESS_ROOT}}\\Jabberwock-Mixar-full"
    },
    "SNARK_MIXAR_BACKEND": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Mixar Local"
    },
    "SNARK_JABBER_BLENDER": {
      "default": "{{SNARK_APPS_ROOT}}\\Jabberwock Blender"
    },
    "SNARK_MIXAR_INSTALL": {
      "default": "C:\\Program Files\\Mixar"
    },
    "SNARK_MIXAR_PROFILE": {
      "default": "{{APPDATA}}\\Mixar\\Mixar\\5.2"
    },
    "SNARK_REGISTRY_PATH": {
      "default": "{{LOCALAPPDATA}}\\SnarkRoute\\service-registry.json"
    },
    "SNARK_AI_ROOT": {
      "default": "I:\\AI"
    },
    "PERSONA_HOME": {
      "default": "I:\\PersonaCore"
    },
    "SNARK_ARCENGINE": {
      "default": "{{SNARK_AI_ROOT}}\\ArcEngine"
    },
    "SNARK_HOLLYWOOD": {
      "default": "{{SNARK_APPS_ROOT}}\\Hollywood_2.0"
    },
    "SNARK_FREETOKEN": {
      "default": "{{SNARK_AI_ROOT}}\\FreeToken Desktop"
    },
    "SNARK_BONSAI": {
      "default": "{{SNARK_AI_ROOT}}\\Bonsai-demo"
    }
  },
  "prerequisites": [
    {
      "id": "git",
      "command": "git",
      "required": true,
      "winget_id": "Git.Git"
    },
    {
      "id": "node",
      "command": "node",
      "required": true,
      "winget_id": "OpenJS.NodeJS.LTS"
    },
    {
      "id": "corepack",
      "command": "corepack",
      "required": true
    },
    {
      "id": "python",
      "command": "python",
      "alternatives": [
        "py"
      ],
      "required": true,
      "winget_id": "Python.Python.3.11"
    },
    {
      "id": "uv",
      "command": "uv",
      "required": false,
      "winget_id": "astral-sh.uv"
    },
    {
      "id": "ffmpeg",
      "command": "ffmpeg",
      "required": false,
      "winget_id": "Gyan.FFmpeg"
    },
    {
      "id": "wsl",
      "command": "wsl.exe",
      "required": false
    },
    {
      "id": "nvidia",
      "command": "nvidia-smi",
      "required": false
    },
    {
      "id": "ollama",
      "command": "ollama",
      "required": false,
      "winget_id": "Ollama.Ollama"
    }
  ],
  "components": [
    {
      "id": "snarkroute",
      "label": "SnarkRoute",
      "path": "{{SNARKROUTE_ROOT}}",
      "strategy": "git",
      "remote": "https://github.com/Snark-s/snarkroute.git",
      "snapshot": true,
      "install_commands": [
        "corepack enable",
        "corepack pnpm install --frozen-lockfile"
      ],
      "patch_excludes": [
        "apps/server/data/h3-studio/queue.json",
        "apps/server/data/h3-studio/results/**",
        "apps/server/nohup.out"
      ]
    },
    {
      "id": "mixar-program",
      "label": "Mixar application",
      "path": "{{SNARK_MIXAR_INSTALL}}",
      "strategy": "copy",
      "snapshot": true,
      "requires_admin_restore": true
    },
    {
      "id": "mixar-profile",
      "label": "Mixar user profile and startup scripts",
      "path": "{{SNARK_MIXAR_PROFILE}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "mixar-source",
      "label": "Modified Mixar source",
      "path": "{{SNARK_MIXAR_SOURCE}}",
      "strategy": "git-or-copy",
      "snapshot": true
    },
    {
      "id": "mixar-local-backend",
      "label": "Jabberwock Mixar Local backend",
      "path": "{{SNARK_MIXAR_BACKEND}}",
      "strategy": "git-or-copy",
      "snapshot": true
    },
    {
      "id": "jabberwock-blender",
      "label": "Jabberwock Blender client",
      "path": "{{SNARK_JABBER_BLENDER}}",
      "strategy": "git-or-copy",
      "snapshot": true
    },
    {
      "id": "personacore",
      "label": "PersonaCore",
      "path": "{{PERSONA_HOME}}",
      "strategy": "git-or-copy",
      "snapshot": true,
      "install_commands": [
        "python -m venv .venv",
        ".venv\\Scripts\\python.exe -m pip install -r requirements.txt",
        "npm ci --prefix extension",
        "npm run build --prefix extension"
      ],
      "snapshot_excludes": [
        "config/secrets.*",
        "data/runtime/agent/tasks/**",
        "data/runtime/harness/**"
      ]
    },
    {
      "id": "arcengine",
      "label": "ArcEngine previs",
      "path": "{{SNARK_ARCENGINE}}",
      "strategy": "git",
      "remote": "https://github.com/xaidan777/ArcEngine.git",
      "snapshot": true
    },
    {
      "id": "hollywood2",
      "label": "Hollywood 2",
      "path": "{{SNARK_HOLLYWOOD}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "freetoken",
      "label": "FreeToken Desktop",
      "path": "{{SNARK_FREETOKEN}}",
      "strategy": "copy",
      "snapshot": true
    },
    {
      "id": "bonsai",
      "label": "Bonsai 2 local runtime",
      "path": "{{SNARK_BONSAI}}",
      "strategy": "git",
      "remote": "https://github.com/PrismML-Eng/Bonsai-demo.git",
      "snapshot": true
    }
  ],
  "services": [
    {
      "id": "snarkroute",
      "label": "SnarkRoute API",
      "endpoint": "http://127.0.0.1:4317",
      "probe": {
        "type": "http",
        "path": "/api/capabilities"
      },
      "component": "snarkroute",
      "start": "{{SNARKROUTE_ROOT}}\\start-server.bat",
      "stop": "{{SNARKROUTE_ROOT}}\\stop-snarkroute.bat"
    },
    {
      "id": "mixar-bridge",
      "label": "Mixar/Jabberwock bridge",
      "endpoint": "tcp://127.0.0.1:18765",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 18765
      },
      "component": "mixar-profile"
    },
    {
      "id": "mixar-local-backend",
      "label": "Mixar local backend",
      "endpoint": "http://127.0.0.1:18880",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 18880
      },
      "component": "mixar-local-backend"
    },
    {
      "id": "h3-local",
      "label": "MiniMax H3 local worker",
      "endpoint": "http://127.0.0.1:18080",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 18080
      },
      "component": "snarkroute",
      "resource_class": "gpu-heavy"
    },
    {
      "id": "local-upscale",
      "label": "Local upscale worker",
      "endpoint": "http://127.0.0.1:8091",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 8091
      },
      "component": "snarkroute",
      "resource_class": "gpu"
    },
    {
      "id": "bonsai-local",
      "label": "Bonsai 2 27B local OpenAI API",
      "endpoint": "http://127.0.0.1:8080/v1",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 8080
      },
      "component": "bonsai",
      "resource_class": "gpu-heavy"
    },
    {
      "id": "ollama",
      "label": "Ollama local runtime",
      "endpoint": "http://127.0.0.1:11434",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 11434
      },
      "resource_class": "gpu"
    },
    {
      "id": "freetoken-api",
      "label": "FreeToken OpenAI-compatible API",
      "endpoint": "http://127.0.0.1:1919/v1",
      "probe": {
        "type": "tcp",
        "host": "127.0.0.1",
        "port": 1919
      },
      "component": "freetoken"
    }
  ],
  "inventories": [
    "{{SNARKROUTE_ROOT}}\\workers\\minimax-h3\\model-manifest.yaml",
    "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\model-registry.json",
    "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\video-model-registry.json",
    "{{SNARK_REGISTRY_PATH}}",
    "{{PERSONA_HOME}}\\projects\\registry.json",
    "{{PERSONA_HOME}}\\data\\runtime\\host-mappings.json"
  ],
  "snapshot_excludes": [
    ".git",
    "node_modules",
    ".pnpm-store",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".cache",
    "models",
    "artifacts",
    "reports",
    ".env",
    ".env.local",
    ".env.production",
    "credentials.json",
    "secrets.json",
    ".ruff_cache",
    "graphify-out",
    "test-results",
    "logs",
    "*.tmp",
    "*.part"
  ],
  "global_npm_packages": [
    "@deepseek-ai/dsh@0.1.1-rc.2",
    "pm2@7.0.3"
  ],
  "heavy_inventories": [
    {
      "id": "bonsai-models",
      "path": "{{SNARK_BONSAI}}\\models",
      "hash": true,
      "include": [
        "*.gguf"
      ]
    },
    {
      "id": "local-upscale-models",
      "path": "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\models",
      "hash": true,
      "include": [
        "*"
      ]
    },
    {
      "id": "ai-models",
      "path": "{{SNARK_AI_ROOT}}\\models",
      "hash": false,
      "include": [
        "*"
      ]
    }
  ],
  "wsl_inventories": [
    {
      "id": "h3-models",
      "distro": "Ubuntu-24.04",
      "command": "timeout 20s find ~/h3/models -type f -printf '%p\\t%s\\n' 2>/dev/null | sort"
    },
    {
      "id": "h3-runtime",
      "distro": "Ubuntu-24.04",
      "command": "timeout 20s find ~/h3/runtime -maxdepth 3 -type f -printf '%p\\t%s\\n' 2>/dev/null | sort"
    }
  ],
  "secret_requirements": [
    {
      "id": "snarkroute-env",
      "path": "{{SNARKROUTE_ROOT}}\\.env",
      "restore": "manual-or-vault"
    },
    {
      "id": "local-upscale-env",
      "path": "{{SNARKROUTE_ROOT}}\\workers\\local-upscale\\.env",
      "restore": "manual-or-vault"
    },
    {
      "id": "h3-worker-token",
      "path": "WSL:~/h3/runtime/worker-token",
      "restore": "regenerate"
    },
    {
      "id": "freetoken-auth",
      "path": "Windows credential/keyring",
      "restore": "sign-in-again"
    },
    {
      "id": "personacore-cloud-token",
      "path": "{{PERSONA_HOME}}\\config\\secrets.cloud-token",
      "restore": "regenerate"
    },
    {
      "id": "personacore-extension-token",
      "path": "{{PERSONA_HOME}}\\config\\secrets.extension-token",
      "restore": "regenerate"
    },
    {
      "id": "personacore-harness-credentials",
      "path": "{{PERSONA_HOME}}\\data\\runtime\\harness\\.credentials.yaml",
      "restore": "manual-or-regenerate"
    }
  ]
}
