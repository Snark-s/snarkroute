{
  "name": "snarkroute",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "dev": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "dev:server": "corepack pnpm --filter @snarkroute/server dev",
    "dev:studio": "corepack pnpm --filter @snarkroute/studio dev",
    "dev:snarkroute": "corepack pnpm -r --parallel --stream --filter @snarkroute/server --filter @snarkroute/snarkroute run dev",
    "dev:boojumroute": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "dev:boojumroute:cloud": "set APP_PRODUCT=boojum&& set APP_MODE=cloud&& set APP_DEV_UI=true&& set DATABASE_URL=postgresql://snarkroute:snarkroute@127.0.0.1:5432/snarkroute&& set DEV_USER_ID=00000000-0000-4000-8000-000000000001&& corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "cloud-dev": "corepack pnpm run db:dev:up && corepack pnpm run db:migrate:cloud && corepack pnpm run dev:boojumroute:cloud",
    "db:dev:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate:cloud": "set DATABASE_URL=postgresql://snarkroute:snarkroute@127.0.0.1:5432/snarkroute&& tsx scripts/migrate-cloud-postgres.ts",
    "start:snarkroute": "corepack pnpm -r --parallel --stream --filter @snarkroute/server --filter @snarkroute/snarkroute run dev",
    "start:boojumroute": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "build:boojumroute-deps": "corepack pnpm -r --filter @snarkroute/protocol --filter @snarkroute/storage --filter @snarkroute/executor --filter @snarkroute/nodes --filter @snarkroute/model-registry --filter @snarkroute/core --filter @snarkroute/replicate --filter @snarkroute/gemini --filter @snarkroute/openrouter --filter @snarkroute/polza build",
    "build:snarkroute-deps": "corepack pnpm -r --filter @snarkroute/protocol --filter @snarkroute/executor --filter @snarkroute/nodes --filter @snarkroute/core build",
    "build:dev-deps": "corepack pnpm -r --filter @snarkroute/protocol --filter @snarkroute/storage --filter @snarkroute/executor --filter @snarkroute/nodes --filter @snarkroute/model-registry --filter @snarkroute/core --filter @snarkroute/replicate --filter @snarkroute/gemini --filter @snarkroute/openrouter --filter @snarkroute/polza build",
    "lint": "corepack pnpm -r lint",
    "create-snarknode": "tsx scripts/create-snarknode.ts",
    "create-snarknode:test": "corepack pnpm --filter @snarkroute/nodes test -- create-snarknode",
    "snarknode:pack": "tsx scripts/pack-snarknode.ts",
    "admin:list-users": "tsx scripts/admin-list-users.ts",
    "admin:promote": "tsx scripts/admin-promote.ts",
    "smoke:replicate": "tsx scripts/smoke-replicate.ts",
    "smoke:clarity": "tsx scripts/smoke-clarity-upscaler.ts",
    "smoke:boojum-cloud-dev": "tsx scripts/smoke-boojum-cloud-dev.ts",
    "smoke:auth-config": "tsx scripts/smoke-auth-config.ts",
    "smoke:auth-server-runtime": "tsx scripts/smoke-auth-server-runtime.ts"
  },
  "dependencies": {
    "@snarkroute/executor": "workspace:*",
    "@snarkroute/gemini": "workspace:*",
    "@snarkroute/model-registry": "workspace:*",
    "@snarkroute/nodes": "workspace:*",
    "@snarkroute/openrouter": "workspace:*",
    "@snarkroute/polza": "workspace:*",
    "@snarkroute/protocol": "workspace:*",
    "@snarkroute/replicate": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0"
}
