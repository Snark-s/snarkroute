{
  "name": "snarkroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "dev:server": "corepack pnpm --filter @snarkroute/server dev",
    "dev:studio": "corepack pnpm --filter @snarkroute/studio dev",
    "lint": "corepack pnpm -r lint",
    "smoke:replicate": "tsx scripts/smoke-replicate.ts"
  },
  "dependencies": {
    "@snarkroute/executor": "workspace:*",
    "@snarkroute/nodes": "workspace:*",
    "@snarkroute/protocol": "workspace:*",
    "@snarkroute/replicate": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0"
}
