{
  "name": "snarkroute",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "dev": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "dev:server": "corepack pnpm --filter @snarkroute/server dev",
    "dev:studio": "corepack pnpm --filter @snarkroute/studio dev",
    "dev:snarkroute": "corepack pnpm --filter @snarkroute/snarkroute dev",
    "dev:boojumroute": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "start:snarkroute": "corepack pnpm --filter @snarkroute/snarkroute dev",
    "start:boojumroute": "corepack pnpm -r --parallel --filter @snarkroute/server --filter @snarkroute/studio run dev",
    "lint": "corepack pnpm -r lint",
    "create-snarknode": "tsx scripts/create-snarknode.ts",
    "create-snarknode:test": "corepack pnpm --filter @snarkroute/nodes test -- create-snarknode",
    "snarknode:pack": "tsx scripts/pack-snarknode.ts",
    "smoke:replicate": "tsx scripts/smoke-replicate.ts",
    "smoke:clarity": "tsx scripts/smoke-clarity-upscaler.ts"
  },
  "dependencies": {
    "@snarkroute/executor": "workspace:*",
    "@snarkroute/gemini": "workspace:*",
    "@snarkroute/nodes": "workspace:*",
    "@snarkroute/openrouter": "workspace:*",
    "@snarkroute/polza": "workspace:*",
    "@snarkroute/protocol": "workspace:*",
    "@snarkroute/replicate": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "pnpm@9.1.0"
}
