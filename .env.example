API_PORT=4317
VITE_API_BASE_URL=http://127.0.0.1:4317
APP_PRODUCT=boojum
APP_MODE=local
# Comma-separated Chrome extension IDs permitted to call the local Jabberwock Supervisor API.
JABBERWOCK_SUPERVISOR_EXTENSION_IDS=
# Cancels the downstream model request as well as the Supervisor wait.
JABBERWOCK_SUPERVISOR_TIMEOUT_MS=600000
APP_DEV_UI=false
# APP_DEV_UI must stay false on VPS/production. The server refuses APP_DEV_UI=true with NODE_ENV=production.
NODE_ENV=development
# Cloud auth. Use a long random secret; production cloud requires at least 32 characters.
AUTH_HASH_SECRET=change-me-generate-a-long-random-secret
# Local OAuth redirect examples:
#   Google: http://127.0.0.1:4317/api/auth/google/callback
#   Yandex: http://127.0.0.1:4317/api/auth/yandex/callback
# Production redirect templates:
#   Google: https://api.example.com/api/auth/google/callback
#   Yandex: https://api.example.com/api/auth/yandex/callback
AUTH_BASE_URL=http://127.0.0.1:4317
APP_WEB_URL=http://127.0.0.1:5173
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_AUTH_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
DATABASE_URL=postgresql://snarkroute:snarkroute@127.0.0.1:5432/snarkroute
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=dev@boojum.local
DEV_USER_NAME=Boojum Cloud Dev
BOOJUM_START_CREDITS=100
BOOJUM_BILLING_MODE=server
# Optional fallback when the daily CBR RUB/USD refresh/cache is unavailable.
# Do not rely on a built-in default; production should set this or keep the FX cache warm.
# BOOJUM_RUB_PER_USD=80
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_APP_TITLE=

# Generic local OpenAI-compatible text model provider (Bonsai 2 is one model route).
# Install weights separately; the local Workshop can start and stop the configured runtime.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL_ID=Ternary-Bonsai-2-27B-PQ2_0.gguf
LOCAL_LLM_TIMEOUT_MS=600000
LOCAL_LLM_MAX_CONCURRENCY=1
# Local lifecycle buttons use this already-installed PrismML demo. No weights are downloaded.
BONSAI_DEMO_PATH=I:\AI\Bonsai-demo
BONSAI_PARALLEL=1
SNARKROUTE_SITE_URL=
# Required for POST/GET/DELETE /mcp. Generate a long random value; there is no built-in default.
SNARKROUTE_MCP_TOKEN=
# Optional development/admin fallback for the AE WebSocket bridge. Normal local CEP pairing is automatic. Never reuse SNARKROUTE_MCP_TOKEN here.
SNARKROUTE_AE_BRIDGE_TOKEN=
POLZA_API_KEY=
POLZA_AI_API_KEY=
POLZA_BASE_URL=
# Standalone MiniMax H3-Base worker (never expose the SGLang ports publicly).
H3_WORKER_URL=
H3_WORKER_SERVICE_TOKEN=
# One-click Vast H3 Studio setup. The UI stores these locally; do not commit real values.
VAST_API_KEY=
HF_TOKEN=
H3_ACCEPT_MODEL_LICENSE=
H3_VAST_TEMPLATE_HASH=
H3_VAST_CONNECTION_MODE=ssh_tunnel
H3_VAST_SSH_PRIVATE_KEY=
H3_VAST_MAX_HOURLY_USD=1.2
H3_VAST_EXCLUDED_COUNTRIES=US,GB,KR,AT,BE,BG,HR,CY,CZ,DE,DK,EE,ES,FI,FR,GR,HU,IE,IT,LT,LU,LV,MT,NL,PL,PT,RO,SE,SI,SK
H3_BACKEND=
H3_ENABLED_VARIANTS=
H3_STORAGE_BACKEND=
H3_S3_ENDPOINT_URL=
H3_S3_REGION=
H3_S3_BUCKET=
H3_S3_PREFIX=
SNARKROUTE_ASSET_MAX_UPLOAD_BYTES=104857600
# Hosted H3 Regenerate-2K. The key remains server-side.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
# Operator-configured bootstrap baseline (2026-08-10); verify against the provider catalog.
MINIMAX_H3_REGEN_USD_PER_SECOND=0.05
MINIMAX_H3_REGEN_MAX_BASE_VIDEO_BYTES=104857600
# Local upscale worker (standalone; no ComfyUI, no automatic model downloads)
LOCAL_UPSCALE_WORKER_URL=http://127.0.0.1:8091
LOCAL_UPSCALE_WORKER_TOKEN=

# Optional Decision Layer providers. Disabled by default.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-latest
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_PRIORITY=20

# Needle is an explicit local `needle playground` sidecar. SnarkRoute never
# installs Python or downloads model weights.
NEEDLE_ENABLED=false
NEEDLE_BASE_URL=http://127.0.0.1:7860
NEEDLE_WEIGHTS_ID=
NEEDLE_PRIORITY=15
NEEDLE_HEALTH_TIMEOUT_MS=2000

# Optional production order. Default: rules, then configured providers.
# DECISION_PRODUCTION_BACKENDS=semantic-rules,jev-main,needle-local
DECISION_MAX_ATTEMPTS=3
DECISION_TIMEOUT_MS=30000

# Shadow calls never affect the production response.
DECISION_SHADOW_ENABLED=false
# DECISION_SHADOW_BACKENDS=jev-main,needle-local
DECISION_SHADOW_SAMPLE_RATE=0
DECISION_SHADOW_TIMEOUT_MS=10000

# Optional additional loopback local LLM endpoint. Explicit installed-model allowlist;
# no inference fallback or primary API-key forwarding. Primary LOCAL_LLM_BASE_URL stays unchanged.
# LOCAL_LLM_ADDITIONAL_ENDPOINTS_JSON='[{"baseUrl":"http://127.0.0.1:11434/v1","modelIds":["qwen3:8b","llama3:latest"]}]'
# For confirmed native-tool models only (validate with a disposable mutation smoke first):
# Add "nativeToolModelIds":["qwen3:8b"] to that endpoint to enable toolProtocol=auto.
# Optional "reasoningEffort":"none" keeps the same explicit generation mode across smoke/continuation.
