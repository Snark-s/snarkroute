APP_PRODUCT=boojum
APP_MODE=cloud
PUBLIC_APP_URL=https://boojum.example.com
AUTH_BASE_URL=https://boojum.example.com
APP_WEB_URL=https://boojum.example.com

POSTGRES_DB=boojum
POSTGRES_USER=boojum
POSTGRES_PASSWORD=change-me-long-random-postgres-password
