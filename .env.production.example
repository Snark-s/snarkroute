SESSION_SECRET=change-me-long-random-session-secret
AUTH_HASH_SECRET=change-me-long-random-auth-hash-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

OPENROUTER_API_KEY=
POLZA_API_KEY=
POLZA_AI_API_KEY=
REPLICATE_API_KEY=
REPLICATE_API_TOKEN=

BOOJUM_START_CREDITS=25
ARTIFACTS_DIR=/app/data/assets
